rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function admin() { return signedIn() && userDoc().data.role == 'ADMIN'; }
    function role(r) { return signedIn() && userDoc().data.role == r; }

    match /users/{userId} {
      allow read: if self(userId) || admin();
      allow create: if self(userId)
                    && request.resource.data.role == 'CUSTOMER'
                    && request.resource.data.id == request.auth.uid;
      allow update: if admin() || (
        self(userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.role == resource.data.role
      );
      allow delete: if admin();

      match /devices/{deviceId} {
        allow read: if self(userId) || admin();
        allow create, update, delete: if self(userId) || admin();
      }
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if admin();
      allow update, delete: if admin() || (
        role('RESTAURANT')
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
      );

      match /menuItems/{itemId} {
        allow read: if true;
        allow create, update, delete: if admin() || (
          role('RESTAURANT')
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid
        );
      }
    }

    match /riders/{riderId} {
      allow read: if admin() || self(riderId);
      allow create: if admin();
      allow update: if admin() || (self(riderId) && request.resource.data.id == resource.data.id);
      allow delete: if admin();
    }

    match /orders/{orderId} {
      allow read: if admin() || (signedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.restaurantOwnerId == request.auth.uid
        || resource.data.riderId == request.auth.uid
      ));

      // Orders are created only by the trusted createOrder callable (Admin SDK).
      allow create: if false;

      allow update: if admin() || (
        signedIn()
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.restaurantOwnerId == resource.data.restaurantOwnerId
        && request.resource.data.totalAmount == resource.data.totalAmount
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && (
          (resource.data.customerId == request.auth.uid
            && resource.data.status == 'PLACED'
            && request.resource.data.status == 'CANCELLED')
          ||
          (resource.data.restaurantOwnerId == request.auth.uid && (
            (resource.data.status == 'PLACED' && request.resource.data.status == 'ACCEPTED')
            || (resource.data.status == 'ACCEPTED' && request.resource.data.status == 'PREPARING')
            || (resource.data.status == 'PREPARING' && request.resource.data.status == 'READY')
            || (resource.data.status == 'PLACED' && request.resource.data.status == 'REJECTED')
          ))
          ||
          (resource.data.riderId == request.auth.uid && (
            (resource.data.status == 'RIDER_ASSIGNED' && request.resource.data.status == 'PICKED_UP')
            || (resource.data.status == 'PICKED_UP' && request.resource.data.status == 'OUT_FOR_DELIVERY')
            || (resource.data.status == 'OUT_FOR_DELIVERY' && request.resource.data.status == 'DELIVERED')
          ))
        )
      );
      allow delete: if admin();
    }

    match /kycDocuments/{documentId} {
      allow read: if admin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if admin();
    }

    match /deliveryTracking/{orderId} {
      allow read: if admin() || (signedIn() && (
        get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid
        || get(/databases/$(database)/documents/orders/$(orderId)).data.restaurantOwnerId == request.auth.uid
        || get(/databases/$(database)/documents/orders/$(orderId)).data.riderId == request.auth.uid
      ));
      allow write: if signedIn()
        && get(/databases/$(database)/documents/orders/$(orderId)).data.riderId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if admin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /payments/{paymentId} {
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow write: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
