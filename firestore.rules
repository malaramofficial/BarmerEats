rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && 
             resource.data.role == role || 
             getUserData().role == role;
    }

    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().role == 'ADMIN';
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow users to create their own profile during registration, but enforce non-admin role creation
      allow create: if isAuthenticated() && isOwner(userId) && request.resource.data.role != 'ADMIN';
      // Prevent users from updating their own role (only admins can escalate roles)
      allow update: if isAuthenticated() && isOwner(userId) && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // --- RESTAURANTS COLLECTION ---
    match /restaurants/{restaurantId} {
      allow read: if true; // Public discovery
      // Only Admin or the designated restaurant owner can write
      allow create, update: if isAdmin() || (isAuthenticated() && request.resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin();

      // Nested Menu Collection
      match /menu/{itemId} {
        allow read: if true;
        allow write: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/restaurants/{restaurantId}).data.ownerId == request.auth.uid);
      }
    }

    // --- RIDERS COLLECTION ---
    match /riders/{riderId} {
      allow read: if isAuthenticated();
      // Only the authenticated rider can update their own GPS or status
      allow create: if isAuthenticated() && riderId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && riderId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- ORDERS COLLECTION ---
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.restaurantOwnerId == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        isAdmin()
      );
      
      // Customers can create orders for themselves
      allow create: if isAuthenticated() && 
                    request.resource.data.customerId == request.auth.uid && 
                    request.resource.data.status == 'PLACED' &&
                    request.resource.data.paymentStatus == 'PENDING';
      
      // Enforce the state machine transition in rules
      allow update: if isAuthenticated() && (
        isAdmin() ||
        // Customer can only cancel their own order under placed state
        (resource.data.customerId == request.auth.uid && 
         request.resource.data.status == 'CANCELLED' && 
         resource.data.status == 'PLACED') ||
        // Restaurant owner can accept, prepare, or reject their restaurant's orders
        (resource.data.restaurantOwnerId == request.auth.uid && (
          (resource.data.status == 'PLACED' && request.resource.data.status == 'RESTAURANT_ACCEPTED') ||
          (resource.data.status == 'PLACED' && request.resource.data.status == 'REJECTED') ||
          (resource.data.status == 'RESTAURANT_ACCEPTED' && request.resource.data.status == 'PREPARING') ||
          (resource.data.status == 'PREPARING' && request.resource.data.status == 'READY_FOR_PICKUP')
        )) ||
        // Riders can accept and progress assigned orders
        (resource.data.riderId == request.auth.uid && (
          (resource.data.status == 'READY_FOR_PICKUP' && request.resource.data.status == 'RIDER_ASSIGNED') ||
          (resource.data.status == 'RIDER_ASSIGNED' && request.resource.data.status == 'RIDER_PICKED_UP') ||
          (resource.data.status == 'RIDER_PICKED_UP' && request.resource.data.status == 'OUT_FOR_DELIVERY') ||
          (resource.data.status == 'OUT_FOR_DELIVERY' && request.resource.data.status == 'DELIVERED')
        ))
      );
      
      allow delete: if isAdmin();
    }

    // --- KYC DOCUMENTS ---
    match /kycDocuments/{documentId} {
      // Document can only be accessed by the creator or admin
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      // Only admins can approve or reject KYC documents
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- GPS DELIVERY TRACKING ---
    match /deliveryTracking/{orderId} {
      allow read: if isAuthenticated() && (
        get(/databases/$(database)/documents/orders/{orderId}).data.customerId == request.auth.uid ||
        get(/databases/$(database)/documents/orders/{orderId}).data.restaurantOwnerId == request.auth.uid ||
        get(/databases/$(database)/documents/orders/{orderId}).data.riderId == request.auth.uid ||
        isAdmin()
      );
      // Only the assigned rider can update the coordinates
      allow write: if isAuthenticated() && get(/databases/$(database)/documents/orders/{orderId}).data.riderId == request.auth.uid;
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == 'PUBLIC');
      allow create: if isAdmin() || isAuthenticated(); // Allow internal order state triggers
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
